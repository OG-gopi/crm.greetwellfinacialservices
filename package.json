{
  "name": "crmgreetwellfinacialservices.com",
  "version": "1.0.0",
  "description": "Greetwell Financial Services CRM Portal",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "postinstall": "node scripts/generate-prisma.js",
    "build:backend": "node scripts/generate-prisma.js && tsc -p backend/tsconfig.json",
    "build:frontend": "npm --prefix frontend run build && node -e \"const fs=require('fs'); ['dist', 'public', 'build'].forEach(d => fs.cpSync('frontend/dist', d, {recursive: true}));\"",
    "build": "npm run build:backend && npm run build:frontend",
    "vercel-build": "npm run build",
    "start": "cd backend && npm start",
    "test": "cd backend && npm test"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "prisma": "^5.22.0",
    "typescript": "^5.3.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.9.6",
    "@rollup/rollup-win32-x64-msvc": "^4.9.6"
  },
  "keywords": [
    "greetwell",
    "financial-services",
    "crm",
    "portal"
  ],
  "author": "Greetwell Financial Services",
  "license": "ISC"
}
